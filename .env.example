# Secrets do BACKEND (NestJS em backend/).
# NUNCA versione o arquivo .env real.

# Chave da API do Groq (formato: gsk_...)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo Groq (opcional — prefira leve; 120b estoura cota diária rápido)
# GROQ_MODEL=qwen/qwen3.8-27b
# Evite openai/gpt-oss-120b no tier gratuito (200k tokens/dia)

# Chave da Brave Search API (opcional — fallback de imagens)
BRAVE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Places API (fotos reais dos lugares recomendados)
# Ative "Places API (New)" no Google Cloud e cole a chave aqui.
GOOGLE_PLACES_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI Embeddings (opcional — RAG pgvector; sem chave usa vetorizador local 1536d)
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Reserva quando a Groq não responde. Na VPS isso aponta para o Ollama do cluster.
# Local fica desligado se a URL estiver vazia, para não carregar o modelo nesta máquina.
# LLM_FALLBACK_BASE_URL=http://ollama.unbora.svc.cluster.local:11434/v1
# LLM_FALLBACK_MODEL=llama3.2:3b

# Google OAuth 2.0 (Validação de login social no backend e mobile)
# Opcional para desenvolvimento local (possui fallback de simulação)
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
# GOOGLE_IOS_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
# GOOGLE_ANDROID_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Origem permitida para CORS
ALLOWED_ORIGIN=*

# Porta do backend NestJS
PORT=3001

# Portal admin — superadmin (lido do .env raiz)
SUPERADMIN_EMAIL=admin@unbora.com
SUPERADMIN_PASSWORD=troque-esta-senha
SUPERADMIN_NAME=Super Admin
ADMIN_JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# PostgreSQL do Unbora na VPS (namespace unbora, banco unbora).
# Dentro do cluster: postgres.unbora.svc.cluster.local:5432
# Da máquina local: IP da VPS na porta 30432, sslmode=disable
DATABASE_URL=postgresql://unbora:senha@173.212.242.9:30432/unbora?sslmode=disable

# Kafka publicado na VPS (namespace data).
UNBORA_KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=kafka-service.data.svc.cluster.local:9092

# URL pública da API (HTTPS em produção). Quando setado, as fotos saem como
# {APP_PUBLIC_BASE_URL}/api/media/p/{id} — o app carrega direto via expo-image.
# Local: deixe vazio (mobile usa EXPO_PUBLIC_API_BASE_URL).
# APP_PUBLIC_BASE_URL=https://api.seudominio.com

# ── Mobile (mobile/.env) ───────────────────────────────────────
# Local (emulador com adb reverse):
# EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3001
# Produção / túnel HTTPS:
# EXPO_PUBLIC_API_BASE_URL=https://api.seudominio.com

# ── Frontend admin (frontend/.env.local) ─────────────────────────
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
