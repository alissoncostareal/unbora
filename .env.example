# Secrets do BACKEND (NestJS em backend/).
# NUNCA versione o arquivo .env real.

# Chave da API do Groq (formato: gsk_...)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo Groq (opcional — prefira leve; 120b estoura cota diária rápido)
# GROQ_MODEL=qwen/qwen3.8-27b
# Evite openai/gpt-oss-120b no tier gratuito (200k tokens/dia)

# Chave da Brave Search API (opcional — fallback de imagens)
BRAVE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Places API (fotos reais dos lugares recomendados)
# Ative "Places API (New)" no Google Cloud e cole a chave aqui.
GOOGLE_PLACES_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI Embeddings (opcional — RAG pgvector; sem chave usa vetorizador local 1536d)
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Google OAuth 2.0 (Validação de login social no backend e mobile)
# Opcional para desenvolvimento local (possui fallback de simulação)
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
# GOOGLE_IOS_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
# GOOGLE_ANDROID_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Origem permitida para CORS
ALLOWED_ORIGIN=*

# Porta do backend NestJS
PORT=3001

# Portal admin — superadmin (lido do .env raiz)
SUPERADMIN_EMAIL=admin@unbora.com
SUPERADMIN_PASSWORD=troque-esta-senha
SUPERADMIN_NAME=Super Admin
ADMIN_JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# PostgreSQL (Neon, Supabase, Railway, etc.)
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco?sslmode=require

# ── Mobile (mobile/.env) ───────────────────────────────────────
# EXPO_PUBLIC_API_BASE_URL=http://localhost:3001

# ── Frontend admin (frontend/.env.local) ─────────────────────────
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
