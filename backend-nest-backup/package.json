{
  "name": "unbora-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/run-with-root-env.js prisma migrate dev",
    "db:deploy": "node scripts/run-with-root-env.js prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/client": "^6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.6.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@types/express": "^5.0.3",
    "@types/node": "^22.17.2",
    "prisma": "^6.19.3",
    "typescript": "^5.9.2"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
