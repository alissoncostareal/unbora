# Copie para .env (Metro lê EXPO_PUBLIC_*):
#
# Local (emulador + adb reverse tcp:3001):
# EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3001
#
# Produção / túnel HTTPS (recomendado — fotos via URL direta no expo-image):
# EXPO_PUBLIC_API_BASE_URL=https://unbora.onrender.com
#
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
