{
  "name": "unbora-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "EXPO_UNSTABLE_BONJOUR=0 expo start --dev-client",
    "start:go": "EXPO_UNSTABLE_BONJOUR=0 expo start",
    "android": "EXPO_UNSTABLE_BONJOUR=0 expo start --dev-client --android",
    "android:run": "expo run:android",
    "ios": "EXPO_UNSTABLE_BONJOUR=0 expo start --dev-client --clear",
    "ios:sim": "EXPO_UNSTABLE_BONJOUR=0 REACT_NATIVE_PACKAGER_HOSTNAME=127.0.0.1 expo start --dev-client --localhost --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "eas:login": "eas login",
    "eas:build:android": "eas build -p android --profile development"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.4",
    "expo-auth-session": "~57.0.12",
    "expo-blur": "~57.0.0",
    "expo-constants": "~57.0.3",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.0",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.0",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.2",
    "expo-location": "~57.0.17",
    "expo-router": "~57.0.4",
    "expo-status-bar": "~57.0.0",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "^15.15.5",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/node": "^22.17.2",
    "@types/react": "~19.2.2",
    "eas-cli": "^24.4.0",
    "typescript": "~6.0.3"
  }
}
